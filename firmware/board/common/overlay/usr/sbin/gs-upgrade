#!/bin/sh
# gs-upgrade: the GS image's upgrader, for the goggles menu and for ssh.
#
#   gs-upgrade find                          this board's packages on the media
#   gs-upgrade check stable|snapshot         fetch the GitHub release record
#   gs-upgrade start file <path>             upgrade, detached (the menu)
#   gs-upgrade start online <url> <version>
#   gs-upgrade cancel                        honoured in download/unpack/verify; for the drone, until the file is sent
#   gs-upgrade install <file> [-y]           upgrade in the foreground (ssh)
#   gs-upgrade install --online stable|snapshot [-y]
#   gs-upgrade notify                        once per boot: mark a newer release
#   gs-upgrade drone check [<version> <board>]   the drone's update, by the GS's version
#   gs-upgrade drone start <url> <version>   update the drone, detached (the menu)
#
# Phases: download (online only), unpack, verify, stop, write, reboot.
# Progress goes to $DIR/status (state=, phase=, done=, total=, msg=),
# replaced whole by a rename. Up to stop, a failure leaves the GS running as
# it was; a failure in stop starts again what it stopped; a failure in write
# leaves the board for a reflash and says so. The package is never deleted.
#
# The write overwrites the partition this system runs from, so from stop on
# the script runs from a RAM copy of itself, busybox, its libraries and the
# loader, and calls every command as "$BB <applet>": a bare applet name
# would exec the rootfs symlink and load the rootfs loader.

DIR=${GS_UPGRADE_DIR:-/tmp/gs-upgrade}
MEDIA=${GS_UPGRADE_MEDIA:-/media/dvr}
DAPI=${GS_UPGRADE_DRONE_API:-https://api.github.com/repos/gilankpam/mabur}
MABURUP=${GS_UPGRADE_MABURUP:-/usr/local/bin/maburup}
OSR=${GS_UPGRADE_OS_RELEASE:-/etc/os-release}
API=${GS_UPGRADE_API:-https://api.github.com/repos/gilankpam/mabur-ground}
INITD=${GS_UPGRADE_INITD:-/etc/init.d}
# Buildroot's libcurl on mbedTLS has no default CA store, so every call names it.
CACERT=${GS_UPGRADE_CACERT:-/etc/ssl/certs/ca-certificates.crt}
ROUTE=${GS_UPGRADE_ROUTE:-/proc/net/route}
U=$DIR/unpack
DL=$DIR/download.tar.gz
# The busybox the write phase copies to RAM (a test points it elsewhere).
BUSYBOX=${GS_UPGRADE_BUSYBOX:-/bin/busybox}
CHUNK=4194304

usage() {
	sed -n '3,13s/^# *//p' "$0" >&2
	exit 2
}

osr() { sed -n "s/^$1=//p" "$OSR" | head -n 1 | tr -d '"'; }

fsize() {
	# shellcheck disable=SC2046
	set -- $(ls -ln "$1" 2>/dev/null)
	echo "${5:-0}"
}

# st <state> <phase> <done> <total> [msg]
st() {
	printf 'state=%s\nphase=%s\ndone=%s\ntotal=%s\nmsg=%s\n' "$1" "$2" "$3" "$4" "$5" >"$DIR/status.tmp"
	$BB mv -f "$DIR/status.tmp" "$DIR/status"
	[ "$MODE" = tty ] || return 0
	case $1 in
	running) echo "$2 $3/$4" ;;
	*) echo "$1${5:+ $5}" ;;
	esac
}

# The lock is a directory (mkdir is the atomic take) holding the run's pid.
# A run killed before it could drop the lock leaves a pid that is gone, and
# such a lock is taken over; one with no pid yet counts as live.
take_lock() {
	mkdir -p "$DIR" || return 1
	if ! mkdir "$DIR/lock" 2>/dev/null; then
		lp=$(cat "$DIR/lock/pid" 2>/dev/null)
		[ -n "$lp" ] && ! kill -0 "$lp" 2>/dev/null || return 1
		# shortcut: two takers racing over one stale lock can both win; only
		# the menu and ssh take it, so a guard is not worth the code.
		rm -rf "$DIR/lock" && mkdir "$DIR/lock" 2>/dev/null || return 1
	fi
	echo $$ >"$DIR/lock/pid"
}
drop_lock() { $BB rm -rf "$DIR/lock"; }

# abort <state> <msg>: a stop before the stop phase; nothing on the board
# has changed, so clean up the RAM copies and hand the lock back.
abort() {
	trap - INT TERM HUP
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	[ -n "$gz" ] && kill "$gz" 2>/dev/null
	rm -rf "$U" "$DL" "$DIR/fifo" "$DIR/headers" "$DIR/http" "$DIR/cancel" "$DIR/ram" "$DIR/drone/maburd" "$DIR/drone/maburd.sha256" "$DIR/drone/up.out"
	drop_lock
	st "$1" "$PHASE" 0 0 "$2"
	exit 1
}

cancelled() {
	[ -e "$DIR/cancel" ] && abort cancelled "Cancelled"
	return 0
}

# curl_err <curl exit>: "<code> <text>"
curl_err() {
	case $1 in
	6 | 7 | 28) echo "network No network" ;;
	35 | 60) echo "tls Certificate check failed" ;;
	*) echo "http Request failed (curl $1)" ;;
	esac
}

do_find() {
	mkdir -p "$DIR" && rm -rf "$DIR/pkg"
	n=0
	for f in "$MEDIA/$BOARD.tar.gz" "$MEDIA"/mabur-ground-*-"$BOARD".tar.gz; do
		[ -f "$f" ] || continue
		n=$((n + 1))
		mkdir -p "$DIR/pkg/$n"
		# VERSION and CHANGELOG are the first two members, so the first MiB
		# of the stream holds them and the rootfs is never read. A package
		# built before them leaves the directory empty.
		gunzip -c "$f" 2>/dev/null | head -c 1048576 | tar xf - -C "$DIR/pkg/$n" VERSION CHANGELOG 2>/dev/null
		echo "pkg $n $f"
	done
	return 0
}

# net_ok: no default route or an unsynced clock is one "error <code> <text>" line.
net_ok() {
	# Hotspot mode (the default) has no default route: say so, rather than
	# blame the clock that a board with no network can never sync.
	if ! awk '$2 == "00000000" { f = 1 } END { exit !f }' "$ROUTE" 2>/dev/null; then
		echo "error network No network"
		return 1
	fi
	# No battery-backed clock: one earlier than the image's own build is
	# certainly unsynced, and TLS would fail on it for a confusing reason.
	epoch=$(osr BUILD_EPOCH)
	if [ "$(date +%s)" -lt "${epoch:-0}" ]; then
		echo "error clock Clock not synced yet — try again in a minute"
		return 1
	fi
}

# fetch_json <api> <path> <out>: a release record, or one "error <code> <text>" line.
fetch_json() {
	net_ok || return 1
	mkdir -p "$DIR"
	code=$(curl -s -L --cacert "$CACERT" --connect-timeout 15 -m 60 \
		-H 'Accept: application/vnd.github+json' \
		-o "$3.tmp" -w '%{http_code}' "$1/$2" 2>/dev/null)
	rc=$?
	[ $rc = 0 ] || { echo "error $(curl_err $rc)"; return 1; }
	case $code in
	200) mv -f "$3.tmp" "$3" && return 0 ;;
	404) echo "error notfound No release found" ;;
	*) echo "error http HTTP $code" ;;
	esac
	rm -f "$3.tmp"
	return 1
}

# do_check <channel> [out]: the release record into out (default
# release.json, the manual check's), or one "error <code> <text>" line.
do_check() {
	out=${2:-$DIR/release.json}
	case $1 in
	stable) path=releases/latest ;;
	snapshot) path=releases/tags/snapshot ;;
	*) usage ;;
	esac
	fetch_json "$API" "$path" "$out"
}

# do_run <menu|tty> file <path> | <menu|tty> online <url> <version>
# Called with the lock held.
do_run() {
	MODE=$1 KIND=$2 SRC=$3 WANT=$4 pid='' gz=''
	# The lock names this shell, which the exec into the write keeps.
	echo $$ >"$DIR/lock/pid"
	if [ "$KIND" = online ]; then PHASE=download; else PHASE=unpack; fi
	trap 'abort cancelled Interrupted' INT TERM HUP

	if [ "$KIND" = online ]; then
		# shortcut: the download's size is unknown until it starts, so 128 MiB
		# stands in for it; read the asset's size from release.json once
		# packages near that.
		need=131072
	else
		[ -f "$SRC" ] || abort error "Package not found"
		need=$(($(fsize "$SRC") / 1024))
	fi
	need=$((need * 5 / 2))
	free=${GS_UPGRADE_FREE_KB:-$(df -Pk "$DIR" | awk 'NR == 2 { print $4 }')}
	[ "${free:-0}" -ge "$need" ] ||
		abort error "Not enough free space: needs $((need / 1024)) MiB, $((${free:-0} / 1024)) MiB free"

	if [ "$KIND" = online ]; then
		st running download 0 0
		rm -f "$DIR/headers" "$DIR/http"
		curl -s -L --cacert "$CACERT" --connect-timeout 15 --speed-limit 1024 --speed-time 30 \
			-D "$DIR/headers" -o "$DL" -w '%{http_code}' "$SRC" >"$DIR/http" 2>/dev/null &
		pid=$!
		while kill -0 "$pid" 2>/dev/null; do
			cancelled
			total=$(tr -d '\r' 2>/dev/null <"$DIR/headers" | sed -n 's/^[Cc]ontent-[Ll]ength: *//p' | tail -n 1)
			st running download "$(fsize "$DL")" "${total:-0}"
			sleep 0.5
		done
		wait "$pid"
		rc=$? pid=''
		cancelled
		[ $rc = 0 ] || abort error "$(curl_err $rc | cut -d' ' -f2-)"
		case $(cat "$DIR/http" 2>/dev/null) in
		200) ;;
		# The snapshot is deleted and re-created by CI: its asset went away.
		404) abort error "Snapshot changed — check again" ;;
		*) abort error "Download failed: HTTP $(cat "$DIR/http" 2>/dev/null)" ;;
		esac
		pkg=$DL
	else
		pkg=$SRC
	fi

	PHASE=unpack
	total=$(fsize "$pkg")
	rm -rf "$U" "$DIR/fifo" && mkdir -p "$U" && mkfifo "$DIR/fifo" || abort error "Could not unpack in $DIR"
	st running unpack 0 "$total"
	# Two jobs on a FIFO, not a pipeline, so that a cancel can kill both and
	# each exit status comes from wait. tar can stop at the end-of-archive
	# marker with gunzip still writing the padding, so the reader drains the
	# rest: gunzip's status stays meaningful, and it matters, because busybox
	# tar takes an EOF on a member boundary for the end of the archive.
	gunzip -c "$pkg" >"$DIR/fifo" &
	gz=$!
	{
		tar xf - -C "$U"
		r=$?
		cat >/dev/null
		exit $r
	} <"$DIR/fifo" &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		cancelled
		d=$(ls -ln "$U" | awk '{ s += $5 } END { print s + 0 }')
		[ "$d" -gt "$total" ] && d=$total
		st running unpack "$d" "$total"
		sleep 0.5
	done
	wait "$pid"
	t=$?
	wait "$gz"
	g=$? pid='' gz=''
	rm -f "$DIR/fifo"
	cancelled
	[ $t = 0 ] && [ $g = 0 ] || abort error "Package damaged"
	rm -f "$DL"
	st running unpack "$total" "$total"

	PHASE=verify
	st running verify 0 0
	[ -f "$U/rootfs.squashfs" ] && [ -f "$U/rootfs.squashfs.md5sum" ] || abort error "Package damaged"
	[ ! -f "$U/u-boot.bin" ] || [ -f "$U/u-boot.bin.md5sum" ] || abort error "Package damaged"
	for m in "$U"/*.md5sum; do
		(cd "$U" && md5sum -c "${m##*/}") >/dev/null 2>&1 || abort error "Checksum mismatch: ${m##*/}"
	done
	ver=
	if [ -f "$U/VERSION" ]; then
		b=$(sed -n 's/^board=//p' "$U/VERSION" | head -n 1)
		[ "$b" = "$BOARD" ] || abort error "Built for $b"
		ver=$(sed -n 's/^version=//p' "$U/VERSION" | head -n 1)
		# Only a stamped package can be compared: an older release has no VERSION.
		[ "$KIND" != online ] || [ "$ver" = "$WANT" ] || abort error "Snapshot changed — check again"
	fi
	# The partition size is checked here rather than in write, so that a
	# rootfs too big for p1 is refused with everything still running.
	BOOT_DISK=${BOOT_DISK:-/dev/$(basename "$(readlink -f /dev/disk/by-partlabel/rootfs)" p1)}
	p1=${BOOT_DISK}p1
	if [ -b "$p1" ]; then
		psize=$(($(cat "/sys/class/block/${p1##*/}/size") * 512))
	elif [ -f "$p1" ]; then
		psize=$(fsize "$p1")
	else
		abort error "No rootfs partition $p1"
	fi
	[ -e "$BOOT_DISK" ] || abort error "No boot disk $BOOT_DISK"
	RSIZE=$(fsize "$U/rootfs.squashfs")
	[ "$RSIZE" -lt "$psize" ] || abort error "Rootfs too big for the partition: $RSIZE bytes, partition $psize"
	cancelled

	if [ "$MODE" = tty ] && [ "$YES" != 1 ]; then
		printf 'Install %s? The GS reboots. Keep the power on. [y/N] ' "${ver:-${WANT:-${SRC##*/}}}"
		read -r a
		[ "$a" = y ] || abort cancelled "Cancelled"
	fi

	PHASE=stop
	st running stop 0 0
	export MODE BOARD BOOT_DISK RSIZE GS_UPGRADE_DIR="$DIR"
	[ "$GS_UPGRADE_TEST" = 1 ] && do_write
	stage || abort error "Could not copy the upgrader to RAM"
	export GSU_BB="$BBX"
	# shellcheck disable=SC2086
	exec $BBX sh "$DIR/ram/gs-upgrade" __write
}

# stage: copy this script, busybox, its libraries and the loader to
# $DIR/ram and set BBX to the command line that runs that busybox.
stage() {
	R=$DIR/ram
	rm -rf "$R" && mkdir -p "$R" || return 1
	cp "$0" "$R/gs-upgrade" && cp "$BUSYBOX" "$R/busybox" || return 1
	# The loader prints what it maps; a static busybox prints no paths.
	libs=$(LD_TRACE_LOADED_OBJECTS=1 "$BUSYBOX" 2>/dev/null |
		awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\/.*\.so/) print $i }')
	ld=
	for l in $libs; do
		cp "$l" "$R/" || return 1
		case ${l##*/} in ld-*) ld=$R/${l##*/} ;; esac
	done
	if [ -z "$libs" ]; then
		BBX=$R/busybox
	elif [ -n "$ld" ]; then
		BBX="$ld --library-path $R $R/busybox"
	else
		return 1
	fi
	# A copy that cannot run must fail here, while abort can still hand the
	# lock back: after the exec there is nothing left to report it.
	# shellcheck disable=SC2086
	$BBX true
}

# stop_svc <name> <verb>: on failure, start again what was stopped and give
# up. From the menu, maburplay's respawn loop (taken down by hold) is re-armed.
stop_svc() {
	[ -x "$INITD/$1" ] || return 0
	if "$INITD/$1" "$2"; then
		[ "$2" = stop ] && stopped="$1 $stopped"
		return 0
	fi
	# What starts again gets the signals back: do_write ignores them.
	trap - INT TERM HUP PIPE
	for s in $stopped; do "$INITD/$s" start; done
	[ "$MODE" = menu ] && [ -x "$INITD/S97maburplay" ] && "$INITD/S97maburplay" watch
	$BB rm -rf "$DIR/ram"
	drop_lock
	st error stop 0 0 "Could not stop $1"
	exit 1
}

write_failed() {
	drop_lock
	st error write "$1" "$RSIZE" "Write failed — reflash from SD card"
	exit 1
}

# do_write: stop, write and reboot. Runs from the RAM copy outside test mode.
do_write() {
	# From here on an interrupted run (an ssh session dropping) must not
	# stop a half-done write. Set after the exec, not before it: a signal
	# ignored when a shell starts can never be restored in it, nor in what
	# it starts.
	trap '' INT TERM HUP PIPE
	PHASE=stop stopped=
	if [ "$MODE" = menu ]; then
		# maburplay keeps drawing the progress; only its respawn loop goes,
		# so a crash cannot exec a binary from the half-written rootfs.
		stop_svc S97maburplay hold
	else
		stop_svc S97maburplay stop
	fi
	stop_svc S96maburgs stop
	for s in S50crond S02klogd S01syslogd; do
		# Their stop fails when the daemon is already gone: nothing to stop.
		[ ! -x "$INITD/$s" ] || "$INITD/$s" stop || echo "$s: stop failed, going on"
	done
	# The player marks ui-ready once it has finished any recording and locked
	# itself in memory; the flash goes ahead without it after 5 s.
	if [ "$MODE" = menu ]; then
		i=0
		while [ ! -e "$DIR/ui-ready" ] && [ $i -lt 10 ]; do
			$BB sleep 0.5
			i=$((i + 1))
		done
	fi

	PHASE=write
	st running write 0 "$RSIZE"
	if [ -f "$U/u-boot.bin" ]; then
		# The write is at sector 64 (32 KiB), the Rockchip offset. On the
		# Orange Pi it would run over the H618's SPL at 256 KiB and the board
		# would no longer boot, so it never happens there.
		if [ "$BOARD" = orangepi_zero2w ]; then
			echo "u-boot.bin not written on $BOARD: bootloader left alone"
		else
			$BB dd if="$U/u-boot.bin" of="$BOOT_DISK" seek=64 conv=notrunc,fsync 2>/dev/null || write_failed 0
		fi
	fi
	n=0 wrote=0
	while [ "$wrote" -lt "$RSIZE" ]; do
		$BB dd if="$U/rootfs.squashfs" of="${BOOT_DISK}p1" bs=$CHUNK skip=$n seek=$n count=1 \
			conv=notrunc,fsync 2>/dev/null || write_failed "$wrote"
		n=$((n + 1))
		wrote=$((n * CHUNK))
		[ "$wrote" -gt "$RSIZE" ] && wrote=$RSIZE
		st running write "$wrote" "$RSIZE"
	done
	$BB sync || write_failed "$wrote"

	PHASE=reboot
	st rebooting reboot 0 0
	[ "$GS_UPGRADE_TEST" = 1 ] && exit 0
	echo s >/proc/sysrq-trigger
	echo u >/proc/sysrq-trigger
	$BB sleep 1
	echo b >/proc/sysrq-trigger
	# Only reached if sysrq is off or refused the reboot.
	$BB reboot -f
	exit 0
}

do_start() {
	case $1 in
	file) [ $# = 2 ] ;;
	online) [ $# = 3 ] ;;
	*) false ;;
	esac || usage
	take_lock || { echo "error busy An update is already running"; exit 1; }
	rm -f "$DIR/cancel" "$DIR/ui-ready"
	if [ "$1" = online ]; then first=download; else first=unpack; fi
	st running "$first" 0 0
	# setsid: the run outlives maburplay, which started it.
	if [ "$GS_UPGRADE_TEST" = 1 ]; then s=; else s=setsid; fi
	$s sh "$0" __run menu "$@" </dev/null >"$DIR/log" 2>&1 &
	# The run's pid, before this shell exits and its own pid in the lock dies.
	echo $! >"$DIR/lock/pid"
	echo started
}

# This board's package URL in a release record, or nothing.
release_url() {
	grep -o "\"browser_download_url\": *\"[^\"]*-$BOARD\.tar\.gz\"" "$1" |
		head -n 1 | sed 's/.*: *"//; s/"$//'
}

# Its version, from the asset name mabur-ground-<version>-<board>.tar.gz.
release_version() {
	url=$(release_url "$1")
	[ -n "$url" ] || return 0
	v=${url##*/mabur-ground-}
	echo "${v%-"$BOARD".tar.gz}"
}

# vnewer <cur> <new>: both vX.Y.Z and new is higher, field by field.
vnewer() {
	echo "$1 $2" | awk '{
		if ($1 !~ /^v[0-9]+\.[0-9]+\.[0-9]+$/ || $2 !~ /^v[0-9]+\.[0-9]+\.[0-9]+$/) exit 1
		split(substr($1, 2), a, "."); split(substr($2, 2), b, ".")
		for (i = 1; i <= 3; i++) if (a[i] + 0 != b[i] + 0) exit !(b[i] + 0 > a[i] + 0)
		exit 1
	}'
}

# Once per boot (S42upgradenotify): retry until one fetch of the channel the
# running version follows succeeds, then leave the newer version in
# $DIR/available for the menu, or remove it. A release follows stable; a
# snapshot follows snapshot, which only moves forward, so any other snapshot
# is newer. Other builds (pr, local) have nothing to compare against.
do_notify() {
	cur=$(osr VERSION)
	if echo "$cur" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then ch=stable
	elif echo "$cur" | grep -Eq '^snapshot-[0-9a-f]+$'; then ch=snapshot
	else exit 0
	fi
	mkdir -p "$DIR"
	until do_check $ch "$DIR/notify.json" >/dev/null; do
		sleep "${GS_UPGRADE_NOTIFY_SLEEP:-30}"
	done
	new=$(release_version "$DIR/notify.json")
	rm -f "$DIR/notify.json"
	if [ $ch = stable ] && vnewer "$cur" "$new" ||
		{ [ $ch = snapshot ] && [ -n "$new" ] && [ "$new" != "$cur" ]; }; then
		echo "$new" >"$DIR/available.tmp" && mv -f "$DIR/available.tmp" "$DIR/available"
	else
		rm -f "$DIR/available"
	fi
	exit 0
}

do_install() {
	YES=0 online='' src=''
	for a; do
		case $a in
		-y) YES=1 ;;
		--online) online=1 ;;
		*) src=$a ;;
		esac
	done
	[ -n "$src" ] || usage
	[ -z "$online" ] || [ "$src" = stable ] || [ "$src" = snapshot ] || usage
	take_lock || { echo "error busy An update is already running"; exit 1; }
	if [ -z "$online" ]; then
		do_run tty file "$src"
		return
	fi
	do_check "$src" || { drop_lock; exit 1; }
	url=$(release_url "$DIR/release.json")
	[ -n "$url" ] || { drop_lock; echo "error No $BOARD package in this release"; exit 1; }
	ver=$(release_version "$DIR/release.json")
	echo "Package ${url##*/}"
	do_run tty online "$url" "$ver"
}

# This board's drone asset URL in a release record, or nothing.
drone_url() {
	grep -o "\"browser_download_url\": *\"[^\"]*-$2-maburd\"" "$1" |
		head -n 1 | sed 's/.*: *"//; s/"$//'
}

# do_drone_check [<drone version> <drone board>]: "ok <version>", with the
# release record in $DIR/drone/release.json, or one "error <code> <text>" line.
do_drone_check() {
	if [ $# = 2 ]; then
		dv=$1 db=$2
	else
		[ $# = 0 ] || usage
		id=$("$MABURUP" ident 2>/dev/null)
		dv=$(echo "$id" | tr ' ' '\n' | sed -n 's/^version=//p')
		db=$(echo "$id" | tr ' ' '\n' | sed -n 's/^board=//p')
		[ -n "$dv" ] && [ -n "$db" ] || { echo "error nodrone No drone found"; return 1; }
	fi
	gv=$(osr VERSION)
	rel=$DIR/drone/release.json
	mkdir -p "$DIR/drone"
	if echo "$gv" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
		gm=${gv%.*}
		if vnewer "$gm.999999" "$dv"; then
			echo "error gsolder Ground station $gv is older than drone $dv. Update the ground station first."
			return 1
		fi
		fetch_json "$DAPI" "releases?per_page=100" "$DIR/drone/list.json" || return 1
		best=
		for t in $(grep -o '"tag_name": *"[^"]*"' "$DIR/drone/list.json" | sed 's/.*: *"//; s/"$//'); do
			echo "$t" | grep -Eq "^$gm\\.[0-9]+\$" || continue
			[ -z "$best" ] || vnewer "$best" "$t" && best=$t
		done
		[ -n "$best" ] || { echo "error norelease No drone release for $gm"; return 1; }
		ver=$best
		if vnewer "$dv" "$best" || ! echo "$dv" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then :
		else
			echo "error uptodate Drone is up to date ($dv)"
			return 1
		fi
		fetch_json "$DAPI" "releases/tags/$best" "$rel" || return 1
	elif echo "$gv" | grep -Eq '^snapshot-[0-9a-f]+$'; then
		fetch_json "$DAPI" releases/tags/snapshot "$rel" || return 1
		url=$(drone_url "$rel" "$db")
		ver=${url##*/mabur-}
		ver=${ver%-"$db"-maburd}
		if [ -n "$url" ] && [ "$ver" = "$dv" ]; then
			echo "error uptodate Drone is up to date ($dv)"
			return 1
		fi
	else
		echo "error testbuild Test build — no drone channel"
		return 1
	fi
	[ -n "$(drone_url "$rel" "$db")" ] || { echo "error noboard No drone build for $db"; return 1; }
	echo "ok $ver"
}

# drone_dl <url> <out>: download with progress, or abort.
drone_dl() {
	rm -f "$DIR/headers" "$DIR/http"
	curl -s -L --cacert "$CACERT" --connect-timeout 15 --speed-limit 1024 --speed-time 30 \
		-D "$DIR/headers" -o "$2" -w '%{http_code}' "$1" >"$DIR/http" 2>/dev/null &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		cancelled
		total=$(tr -d '\r' 2>/dev/null <"$DIR/headers" | sed -n 's/^[Cc]ontent-[Ll]ength: *//p' | tail -n 1)
		st running download "$(fsize "$2")" "${total:-0}"
		sleep 0.2
	done
	wait "$pid"
	rc=$? pid=''
	cancelled
	[ $rc = 0 ] || abort error "$(curl_err $rc | cut -d' ' -f2-)"
	case $(cat "$DIR/http" 2>/dev/null) in
	200) ;;
	404) abort error "Snapshot changed — check again" ;;
	*) abort error "Download failed: HTTP $(cat "$DIR/http" 2>/dev/null)" ;;
	esac
}

# do_drone_run <url> <version>: called with the lock held.
do_drone_run() {
	SRC=$1 WANT=$2 MODE=menu pid='' gz='' PHASE=download
	echo $$ >"$DIR/lock/pid"
	trap 'abort cancelled Interrupted' INT TERM HUP
	f=$DIR/drone/maburd
	mkdir -p "$DIR/drone"
	rm -f "$f" "$f.sha256" "$DIR/drone/up.out"
	st running download 0 0
	drone_dl "$SRC" "$f"
	drone_dl "$SRC.sha256" "$f.sha256"

	PHASE=verify
	st running verify 0 0
	want=$(awk '{ print $1; exit }' "$f.sha256")
	have=$(sha256sum "$f" | awk '{ print $1 }')
	[ -n "$want" ] && [ "$want" = "$have" ] || abort error "Checksum mismatch"
	cancelled

	PHASE=send
	st running send 0 0
	"$MABURUP" install "$f" "$want" >"$DIR/drone/up.out" 2>&1 </dev/null &
	pid=$!
	sent=
	while kill -0 "$pid" 2>/dev/null; do
		set -- $(tail -n 1 "$DIR/drone/up.out" 2>/dev/null)
		case $1 in
		send)
			st running send "${2:-0}" "${3:-0}"
			# All bytes sent: START may be out, so the drone decides alone.
			[ "${2:-0}" != 0 ] && [ "$2" = "$3" ] && sent=1
			;;
		# START answered: the drone installs and boots the new build.
		install) sent=1 PHASE=install; st running install 0 0 ;;
		# The bar fills through the 40 s window: seconds run, not seconds left.
		trial) sent=1 PHASE=trial; st running trial $((40 - ${2:-40})) 40 ;;
		esac
		if [ -z "$sent" ]; then cancelled; else rm -f "$DIR/cancel"; fi
		sleep 0.2
	done
	wait "$pid"
	pid=''
	fin=$(tail -n 1 "$DIR/drone/up.out" 2>/dev/null)
	case $fin in
	committed)
		rm -f "$f" "$f.sha256" "$DIR/drone/up.out"
		drop_lock
		st done result 0 0 "Updated to $WANT"
		exit 0
		;;
	"rolled_back exited") m="Rolled back: the new build exited" ;;
	"rolled_back no_link") m="Rolled back: the new build never linked" ;;
	"rolled_back no_video") m="Rolled back: no video from the new build" ;;
	"refused bad_hash") m="Refused: the file arrived damaged" ;;
	"refused wrong_board") m="Refused: built for another board" ;;
	"refused bad_config") m="Refused: the drone's config does not load" ;;
	"refused busy") m="Refused: the drone is busy" ;;
	"refused no_file") m="Refused: the file did not arrive" ;;
	"error ftp nak "*) m="Transfer refused by the drone (${fin#error ftp nak })" ;;
	"error "*)
		m=${fin#error }
		m=$(echo "$m" | cut -c1 | tr a-z A-Z)$(echo "$m" | cut -c2-)
		;;
	*) m="The drone update stopped" ;;
	esac
	abort error "${m:-Update failed}"
}

do_drone() {
	v=$1
	shift
	case $v in
	check) do_drone_check "$@" ;;
	start)
		[ $# = 2 ] || usage
		take_lock || { echo "error busy An update is already running"; exit 1; }
		rm -f "$DIR/cancel"
		st running download 0 0
		if [ "$GS_UPGRADE_TEST" = 1 ]; then s=; else s=setsid; fi
		$s sh "$0" __drone_run "$@" </dev/null >"$DIR/log" 2>&1 &
		echo $! >"$DIR/lock/pid"
		echo started
		;;
	*) usage ;;
	esac
}

BB=
case $1 in
__write) BB=$GSU_BB ;;
cancel) mkdir -p "$DIR" && touch "$DIR/cancel"; exit ;;
esac
[ -n "$BOARD" ] && [ "$1" = __write ] || BOARD=$(osr BUILD_CONFIG)
[ -n "$BOARD" ] || { echo "error board No BUILD_CONFIG in $OSR"; exit 1; }

case $1 in
find) do_find ;;
check) [ $# = 2 ] || usage; do_check "$2" ;;
notify) do_notify ;;
drone) shift; do_drone "$@" ;;
__drone_run) shift; do_drone_run "$@" ;;
start) shift; do_start "$@" ;;
install) shift; do_install "$@" ;;
__run) shift; do_run "$@" ;;
__write) do_write ;;
*) usage ;;
esac
