#!/bin/sh
# maburplay respawn wrapper -- pixelpilot.sh's loop shape, but a stricter
# stop contract: only exit 2 (config error) and 143 (SIGTERM, what our own
# stop path sends) end the loop. 137 (SIGKILL) RESPAWNS, deliberately
# diverging from pixelpilot.sh: the OOM killer and a crashed-box power cut
# both look like SIGKILL, and an FPV ground station must come back from
# those (the DVR crash gate kills -9 mid-recording to prove it). The
# decode watchdog's exit-for-respawn path (exit 1) also lands here.

case "$1" in
  stop|hold)
    # Kill the wrapper loop first so it cannot respawn, then the player.
    # Exclude $$ AND $PPID: `restart` runs stop as a child, and pidof
    # matches the restarting parent too -- killing it aborted the restart
    # before the new loop ever spawned (found by the acceptance test).
    # `hold` stops at the loop: gs-upgrade keeps the player drawing its
    # progress through the flash, and a player that dies then must not be
    # respawned from the half-written rootfs.
    for pid in $(pidof S97maburplay); do
      [ "$pid" != "$$" ] && [ "$pid" != "$PPID" ] && kill "$pid" 2>/dev/null
    done
    [ "$1" = stop ] && killall maburplay 2>/dev/null
    exit 0
    ;;
  restart)
    "$0" stop
    sleep 1
    ;;
  watch)
    # Re-arm the loop around a player that is still running (gs-upgrade's
    # way back from `hold` when it gives up before the write): wait for it
    # to exit, then respawn as `start` does. Its exit code is not ours to
    # read, so its exit always respawns. A loop already running wins.
    for pid in $(pidof S97maburplay); do
      [ "$pid" != "$$" ] && [ "$pid" != "$PPID" ] && exit 0
    done
    ;;
  start|"") ;;
  *) echo "usage: $0 {start|stop|restart|hold|watch}"; exit 1 ;;
esac

# The GS image keeps its configs on the CONFIG partition; other hosts in /etc.
CONF=/config/maburplay.toml
[ -f "$CONF" ] || CONF=/etc/maburplay.toml

# `watch` appends: the running player still writes to this log.
[ "$1" = watch ] || : >/tmp/maburplay.log
(
  if [ "$1" = watch ]; then
    while pidof maburplay >/dev/null; do sleep 1; done
  fi
  while true; do
    /usr/local/bin/maburplay -c "$CONF"
    rc=$?
    if [ "$rc" = 2 ] || [ "$rc" = 143 ]; then
      echo "maburplay exited: $rc, skip restart ...."
      exit 2
    fi
    echo "maburplay exited: $rc, restart ...."
    sleep 1
  done
) >>/tmp/maburplay.log 2>&1 &
